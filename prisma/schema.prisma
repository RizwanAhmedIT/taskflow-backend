// ============================================================================
// Todo Management Platform — Prisma Schema
// Enterprise-grade, multi-tenant database architecture
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TodoStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ── Organization ────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  User[]
  projects Project[]
  todos    Todo[]
  tags     Tag[]

  @@map("organizations")
}

// ── User ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(MEMBER)
  avatarUrl String?
  isActive  Boolean  @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  assignedTodos  Todo[]         @relation("TodoAssignee")
  createdTodos   Todo[]         @relation("TodoCreator")
  comments       Comment[]
  activityLogs   ActivityLog[]
  createdProjects Project[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ── Refresh Token ───────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  expiresAt DateTime
  device    String?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ── Project ─────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  color       String?   @default("#6366f1")
  deletedAt   DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todos Todo[]

  @@index([organizationId])
  @@map("projects")
}

// ── Todo ────────────────────────────────────────────────────────────────────

model Todo {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TodoStatus   @default(OPEN)
  priority    TodoPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  deletedAt   DateTime?
  position    Int          @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  creatorId String
  creator   User   @relation("TodoCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags         TodoTag[]
  comments     Comment[]
  activityLogs ActivityLog[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, assigneeId])
  @@index([organizationId, projectId])
  @@index([organizationId, dueDate])
  @@index([creatorId])
  @@map("todos")
}

// ── Tag ─────────────────────────────────────────────────────────────────────

model Tag {
  id    String @id @default(uuid())
  name  String
  color String @default("#8b5cf6")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todos TodoTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

// ── TodoTag (Join Table) ────────────────────────────────────────────────────

model TodoTag {
  todoId String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([todoId, tagId])
  @@map("todo_tags")
}

// ── Comment ─────────────────────────────────────────────────────────────────

model Comment {
  id      String @id @default(uuid())
  content String

  todoId String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([todoId])
  @@map("comments")
}

// ── Activity Log ────────────────────────────────────────────────────────────

model ActivityLog {
  id     String @id @default(uuid())
  action String
  entity String
  entityId String
  changes  Json?

  todoId String?
  todo   Todo?   @relation(fields: [todoId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([todoId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("activity_logs")
}
